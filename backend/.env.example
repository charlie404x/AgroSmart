# ============================================================
# AgroSMART Perú — variables de entorno del backend
# Copia este archivo a backend/.env (nunca subas .env al repositorio ni lo incluyas en un ZIP).
# ============================================================

# development | production | test
ENVIRONMENT=development

# Clave para firmar los JWT. OBLIGATORIA, mínimo 32 caracteres, distinta por entorno.
# Genérala con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Minutos de validez del token de acceso. Al vencer, la app pide iniciar sesión otra vez.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cadena de conexión SQLAlchemy. SQLite para desarrollo; PostgreSQL recomendado en producción.
DATABASE_URL=sqlite:///./agrosmart.db

# Orígenes permitidos por CORS, separados por coma. Sólo afecta a Flutter Web;
# la app Android/iOS no usa CORS. En producción deben ser HTTPS y sin '*'.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080

# Límite de intentos en login/registro por IP.
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=5/minute

# En producción /docs está desactivado salvo que se active explícitamente.
ENABLE_DOCS=false
