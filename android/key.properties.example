# Copia este archivo como android/key.properties (NO lo subas al repositorio).
# Crea el keystore con:
#   keytool -genkey -v -keystore ~/agrosmart-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias agrosmart
storePassword=
keyPassword=
keyAlias=agrosmart
storeFile=/ruta/absoluta/agrosmart-release.jks
